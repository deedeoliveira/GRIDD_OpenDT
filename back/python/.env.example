FLASK_API_PORT=3002
# The IFC-extraction service is LOCAL/INTERNAL and has no inbound authentication on its
# own routes. It binds to loopback by default; only change this if the deployment
# genuinely requires another interface.
FLASK_BIND_HOST=127.0.0.1

# AUTHENTICATED Node model-version download base. The service appends /<versionId>/download
# to this trusted base and sends the internal-service token ONLY to the resulting URL.
# A caller can never choose this destination.
MODEL_VERSION_DOWNLOAD_BASE_URL="http://127.0.0.1:3001/api/model/versions"

# LEGACY, UNAUTHENTICATED sensor/process download base (/api/model/download/<modelId>).
# The internal-service token is NEVER sent to this endpoint.
MODEL_DOWNLOAD_ROUTE="http://127.0.0.1:3001/api/model/download"

# Shared internal-service token presented to Node when downloading a promoted model
# version file. MUST match OSWADT_INTERNAL_SERVICE_TOKEN in back/.env. Use a long random
# value; never commit a real token. Example: openssl rand -hex 32
OSWADT_INTERNAL_SERVICE_TOKEN=<generate-a-long-random-internal-service-token>
