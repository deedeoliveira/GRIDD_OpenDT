<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>OSWADT IFC4x3 synthetic model information requirements</title>
        <version>1.1.0</version>
        <description>Public synthetic IDS profile for functional validation demonstrations (ADR-0052: IFC4x3-only; IfcSpace.Name is the institutional inventory code; Pset_SpaceCommon.Reference is not required). The IDS 1.0 schema enumerates only IFC4X3_ADD2 among the IFC4x3 tokens; the runtime accepts IFC4X3, IFC4X3_ADD1, IFC4X3_ADD2 and IFC4X3_TC1, applies entity-based (every IfcSpace) applicability, and runs the executor with version filtering disabled so this profile governs all four accepted variants, never only IFC4X3_ADD2.</description>
        <purpose>Research demonstrator</purpose>
        <milestone>ADR-0052</milestone>
    </info>
    <specifications>
        <specification name="Spaces carry an institutional inventory code in Name" ifcVersion="IFC4X3_ADD2" identifier="IDS-SPACE-NAME" description="Every IfcSpace must provide a non-blank IfcSpace.Name matching the institutional inventory-code pattern. Pset_SpaceCommon.Reference is not required and is ignored.">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCSPACE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required" instructions="Provide the institutional inventory code as IfcSpace.Name, such as T-101.">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[A-Z]-[0-9]{3}" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="Managed demo equipment has an EQP Tag" ifcVersion="IFC4X3_ADD2" identifier="IDS-EQUIPMENT-TAG" description="Every IfcFurnishingElement in this profile must have an EQP-prefixed Tag.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCFURNISHINGELEMENT</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required" instructions="Use a synthetic identifier beginning with EQP-.">
                    <name>
                        <simpleValue>Tag</simpleValue>
                    </name>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="EQP-[A-Z0-9-]+" />
                        </xs:restriction>
                    </value>
                </attribute>
            </requirements>
        </specification>
        <specification name="Building element proxies identify their object type" ifcVersion="IFC4X3_ADD2" identifier="IDS-PROXY-OBJECTTYPE" description="When an IfcBuildingElementProxy is present, ObjectType is required.">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>ObjectType</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
    </specifications>
</ids>
